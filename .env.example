# Groq API — required for cluster labeling (Phase 3+)
GROQ_API_KEY=your_groq_api_key_here

# Reddit API — optional (Phase 1 ingestion)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=blinkit-insight-engine/0.1.0

# Twitter/X API — optional (manual CSV fallback if unavailable)
TWITTER_BEARER_TOKEN=

# Paths (override defaults from config/settings.yaml)
# BLINKIT_DATA_DIR=data
# BLINKIT_METADATA_DB=data/metadata.db

# Logging
LOG_LEVEL=INFO
