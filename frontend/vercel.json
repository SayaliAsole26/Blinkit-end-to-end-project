{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/insights", "destination": "/insights.html" },
    { "source": "/barriers", "destination": "/barriers.html" },
    { "source": "/evidence", "destination": "/evidence.html" },
    { "source": "/shell", "destination": "/shell.html" },
    {
      "source": "/api/:path*",
      "destination": "https://blinkit-api-production.up.railway.app/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
